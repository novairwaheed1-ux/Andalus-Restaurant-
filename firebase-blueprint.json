{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document storing basic information",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "description": "Email address of the user" },
        "avatar": { "type": "string", "description": "User avatar photo URL" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" }
      },
      "required": ["email", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user document containing profile data"
    }
  }
}
